# Copie para .env no servidor. Configure valores reais e fortes antes de subir.
MYSQL_ROOT_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
# Use a mesma senha acima URL-encoded nas duas conexões.
DATABASE_URL_HEART=mysql://root:SENHA_CODIFICADA@mysql:3306/heart
DATABASE_URL_TENANT=mysql://root:SENHA_CODIFICADA@mysql:3306/7bar

# Segredo longo aleatório (>= 32 caracteres)
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_LONGO
SETUP_PIN=DEFINA_PIN_ADMINISTRATIVO
SQL_PIN=DEFINA_PIN_SQL

# Segredo compartilhado entre backend NestJS e microsserviço PHP nfce-service
NFCE_INTERNAL_SECRET=DEFINA_SEGREDO_INTERNO_NFCE
# Mantenha false em produção para validar certificados TLS da SEFAZ usando ICP-Brasil
SEFAZ_DISABLE_CERT_VALIDATION=false

# Console SQL no sys-init fica desabilitado em produção por padrão. Só habilite temporariamente se necessário.
ENABLE_SQL_CONSOLE=false

# URL pública do painel/PWA (usada pelo CORS)
PUBLIC_APP_URL=https://seu-dominio-pdv.com.br
# Origens extras permitidas pelo CORS além da PUBLIC_APP_URL (separadas por vírgula).
CORS_ORIGINS=

# Limites do pool multi-tenant (dimensionado para MySQL max_connections=1000)
TENANT_DB_MAX_CLIENTS=80
TENANT_DB_CONNECTION_LIMIT=6

# Backup off-site (Google Drive OAuth2)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# SMTP (envio de XMLs ao contador)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# ─── Webhook Teltech Leadger (Contrato v1 — travado por padrão até homologar) ─
LEADGER_WEBHOOK_ENABLED=false
LEADGER_WEBHOOK_URL=https://leadger.teltech.com.br/api/webhooks/inbound/sistema-amigo
LEADGER_WEBHOOK_SOURCE=sistema-amigo
# Segredo UTF-8 privado recebido da equipe do Leadger (NUNCA expor no frontend/git)
LEADGER_WEBHOOK_SECRET=
# Habilite true apenas após cadastrar PUBLIC_APP_URL no photoAllowedHosts do Leadger
LEADGER_PHOTO_SYNC_ENABLED=false
